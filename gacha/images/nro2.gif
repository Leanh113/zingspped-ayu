        //Show login modal and mobile login
        function openLoginModal() {
            setTimeout(function() {
                $('#modal-login').modal('show');

            }, 0);
        }

        function openRegisterModal() {
            setTimeout(function() {
                $('#loginRegist').modal('show');

            }, 0);
